# 复制成 .env 并填入真实值。
#
# ⚠️ .env 里是真实密钥，**不要提交到仓库**（.gitignore 已忽略 deploy/.env）。
#
# 有六个是必填的，缺任何一个应用都会因为占位符无法解析而启动失败：
#   DB_USERNAME / DB_PASSWORD / JWT_SECRET / AI_DASHSCOPE_API_KEY / MAIL_USERNAME / MAIL_PASSWORD

# ---- 数据库 ----
# 复用同机 mall-resume 的 MySQL 容器（见 docker-compose.yml 里的 datasource URL）
DB_USERNAME=root
DB_PASSWORD=

# ---- 应用密钥 ----
# 建议 32 字符以上的随机串，可用 openssl rand -base64 32 生成
JWT_SECRET=

# 阿里云百炼 API Key
AI_DASHSCOPE_API_KEY=

# ---- 邮件（注册验证码、找回密码）----
# MAIL_PASSWORD 是 QQ 邮箱的 SMTP **授权码**，不是邮箱登录密码
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- 可选 ----
# 前端对外端口。80 已被同机的 mall-resume 占用，所以默认 8082
NOTEPAD_WEB_PORT=8082
