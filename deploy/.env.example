# 复制成 .env 并填入真实值。
#
# ⚠️ .env 里是真实密钥，**不要提交到仓库**（.gitignore 已忽略 deploy/.env）。
#
# 有六个是必填的，缺任何一个应用都会因为占位符无法解析而启动失败：
#   DB_USERNAME / DB_PASSWORD / JWT_SECRET / AI_DASHSCOPE_API_KEY / MAIL_USERNAME / MAIL_PASSWORD

# ---- 数据库 ----
# 复用同机 mall-resume 的 MySQL 容器（见 docker-compose.yml 里的 datasource URL）
DB_USERNAME=root
DB_PASSWORD=

# ---- 应用密钥 ----
# 建议 32 字符以上的随机串，可用 openssl rand -base64 32 生成
JWT_SECRET=

# 阿里云百炼 API Key
AI_DASHSCOPE_API_KEY=

# ---- 邮件（注册验证码、找回密码）----
# MAIL_PASSWORD 是 QQ 邮箱的 SMTP **授权码**，不是邮箱登录密码
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- 可选 ----
# 前端对外端口。80 已被同机的 mall-resume 占用，所以默认 8082
NOTEPAD_WEB_PORT=8082

# 前端监听地址。**外面如果还有一层宿主机 Nginx 反代，必须设成 127.0.0.1**，
# 否则 8082 公网可达，可以绕过宿主机入口伪造 X-Real-IP，登录限流会被完全绕过。
# 本项目线上就是这种情况，所以线上是 127.0.0.1。
NOTEPAD_WEB_BIND=0.0.0.0

# 登录失败限流（都有默认值，一般不用改）
# 计数存在进程内存里，重启后端容器即可清空并解锁：docker compose restart backend
# 本地联调时所有请求 IP 都是 127.0.0.1，单 IP 兜底会跨测试账号累计，建议把 MAX_PER_IP 调大
NOTEPAD_AUTH_LOGIN_ATTEMPT_MAX_PER_USER_IP=5
NOTEPAD_AUTH_LOGIN_ATTEMPT_MAX_PER_IP=50
# 统计窗口，同时也是锁定时长；支持 15m / 20s / 1h 这类写法
NOTEPAD_AUTH_LOGIN_ATTEMPT_WINDOW=15m

# 运维账号（逗号分隔），允许操作全局向量索引的备份/恢复/校验。
# 索引是全局单例，一次恢复会把所有用户的检索结果一起回退，所以这几个接口默认对所有人关闭。
# 不填 = 谁都不能用；留空时 /api/ai/notes/index/backups 系列会返回 403。
NOTEPAD_INDEX_ADMIN_USERNAMES=
